# 返修期路径约定（Linux 侧唯一配置源）
# 修改本文件即可同时改变自检、打包、会话的落点，其他脚本不要写死路径。
#
# 共享盘以“卷标”定位：Windows 盘符会变，Linux 设备名会在 sdb/sdc 之间跳，卷标不变。
# 本机实际：Windows D: 卷标“资源盘”，NTFS 158.1 GB；Linux 对应 /dev/sdb1。

REV_SHARE_LABEL=资源盘
REV_SHARE_LINUX=/mnt/revshare
# 目录树统一放在分区下的 REV 子目录，避免污染资源盘根目录
REV_ROOT_SUBDIR=REV
REV_SHARE_WIN='D:\REV'

# REV 下的目录（编号前缀用于排序，也表明谁是权威副本）
# 00_handoff  交接材料（实验包、矩阵说明、两边解析出的路径）
# 10_results  每轮会话一个目录，rev_YYYYmmdd_HHMM_<tag>
# 20_paper    论文与图表的备份（Windows 主写）
# 30_images   系统镜像与 AVD 备份（可选）
# 90_tmp      临时交换，可随时清空
REV_DIR_HANDOFF=00_handoff
REV_DIR_RESULTS=10_results
REV_DIR_PAPER=20_paper
REV_DIR_IMAGES=30_images
REV_DIR_TMP=90_tmp

# 代码与中间结果留在 Linux 原生分区；REV_REPO 留空则按脚本位置自动推断
REV_REPO=
