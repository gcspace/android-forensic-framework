#!/usr/bin/env python3
"""
真实 ADB 执行 + 痕迹采集脚本
在真实设备/模拟器上执行原子操作，记录实际耗时
"""
import argparse
import sys
import os
import json
import time
import logging
from datetime import datetime

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from core.scheduler.dag_builder import DAGBuilder
from core.scheduler.priority_scheduler import PriorityScheduler
from core.executor.adb_manager import get_pool
from core.executor.atomic_ops import AtomicFactory
from core.collector.file_snapshot import get_collector, get_boot_time_ms

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)



    """在真实设备上运行场景"""
    logger.info(f"Loading scenario: {yaml_path}")
    
    # 构建DAG
    builder = DAGBuilder()
    builder.load_yaml(yaml_path)
    
    if not builder.validate():
        logger.error("DAG validation failed")
        return None
    
    # 调度
    scheduler = PriorityScheduler(max_concurrency=args.max_concurrency)
    plan = scheduler.schedule(builder)
    
    logger.info(f"Schedule: {plan.total_layers} layers, {plan.total_nodes} nodes")
    
    # 获取ADB设备
    pool = get_pool()
    devices = pool.get_device_list()
    if not devices:
        logger.error("No ADB devices found!")
        return None
    
    serial = devices[0]
    logger.info(f"Using device: {serial}")
    
    # 执行每个层
    total_start = time.time()
    layer_execution_times = []
    collected_evidence = []
    
    for layer_idx, layer_nodes in enumerate(plan.layers):
        layer_start = time.time()
        logger.info(f"Layer {layer_idx+1}/{plan.total_layers}: {len(layer_nodes)} nodes")
        
        # 执行层内所有原子
        for node_id in layer_nodes:
            node = builder.get_node(node_id)
            if not node:
                continue
            
            # 创建原子操作
            atomic = AtomicFactory.create(
                op_type=node.op_type,
                api_level=api_level,
                serial=serial,
                **node.params
            )
            
            # 执行原子
            logger.info(f"  Executing: {node_id} ({node.op_type})")
            result = atomic.execute()
            
            if result.success:
                logger.info(f"    ✅ {node_id} completed in {result.duration_ms:.2f}ms")
            else:
                logger.warning(f"    ❌ {node_id} failed: {result.error}")
            
            # 采集痕迹
            if result.success:
                evidence = atomic.collect_evidence(result)
                collected_evidence.append({
                    'node_id': node_id,
                    'op_type': node.op_type,
                    'timestamp': result.timestamp_start,
                    'duration_ms': result.duration_ms,
                    'evidence': evidence
                })
        
        layer_end = time.time()
        layer_execution_times.append(layer_end - layer_start)
    
    total_time = time.time() - total_start
    
    return {
        'scenario': os.path.basename(yaml_path),
        'api_level': api_level,
        'device_serial': serial,
        'total_nodes': plan.total_nodes,
        'total_layers': plan.total_layers,
        'total_time_seconds': total_time,
        'layer_times': layer_execution_times,
        'evidence': collected_evidence
    }


def main():
    parser = argparse.ArgumentParser(description='Run real device experiment')
    parser.add_argument('api_level', type=int, help='API level (e.g., 33)')
    parser.add_argument('config', type=str, help='Path to config YAML')
    parser.add_argument('--max-concurrency', type=int, default=8, help='ADB session limit (default: 8)')
    parser.add_argument('--scheduler', type=str, default='priority', choices=['priority', 'basic'], help='Scheduler type')
    args = parser.parse_args()
    api_level = int(sys.argv[1]) if len(sys.argv) > 1 else 33
    yaml_path = sys.argv[2] if len(sys.argv) > 2 else 'config/scenarios/baseline_20.yaml'
    
    logger.info(f"Running on API {api_level}: {yaml_path}")
    result = run_scenario_on_device(yaml_path, api_level)
    
    if result:
        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        output_file = f'output/groundtruth/real_execution_{timestamp}.json'
        os.makedirs('output/groundtruth', exist_ok=True)
        with open(output_file, 'w') as f:
            json.dump(result, f, indent=2, ensure_ascii=False)
        logger.info(f"Results saved to: {output_file}")
        print(f"\n=== 执行摘要 ===")
        print(f"API: {api_level}")
        print(f"节点数: {result['total_nodes']}")
        print(f"层数: {result['total_layers']}")
        print(f"总耗时: {result['total_time_seconds']:.2f}s")


if __name__ == '__main__':
    main()
