#!/usr/bin/env python3
import subprocess
import time
import hashlib
import os
from typing import Dict, Any, List, Tuple, Optional
from abc import ABC, abstractmethod
from dataclasses import dataclass
import logging

logger = logging.getLogger(__name__)


@dataclass
class AtomicResult:
    success: bool
    stdout: str
    stderr: str
    timestamp_start: float
    timestamp_end: float
    duration_ms: float
    evidence: Dict[str, Any] = None
    error: str = None

    def __post_init__(self):
        if self.evidence is None:
            self.evidence = {}


# 导入依赖
from core.executor.adb_manager import get_pool
from core.collector.file_snapshot import get_collector, get_boot_time_ms


class AtomicOperation(ABC):
    """原子操作基类"""

    def __init__(self, api_level: int, serial: str = None, **kwargs):
        self.api_level = api_level
        self.serial = serial
        self.params = kwargs.get('params', {})
        self.pool = get_pool()
        self.collector = get_collector()
        self._api_branch = self._get_api_branch(api_level)

    def _get_api_branch(self, api_level: int) -> str:
        if api_level <= 28:
            return "global_file"
        elif api_level == 29:
            return "legacy_mode"
        else:
            return "saf_only"

    def _get_media_path(self, subpath: str = "") -> str:
        if self.api_level <= 28:
            return f"/sdcard/{subpath}"
        else:
            return f"/data/local/tmp/{subpath}"

    def _execute_adb(self, command: str, timeout: int = 30) -> Tuple[str, str, int]:
        return self.pool.execute_with_retry(command, self.serial)

    def _execute_adb_raw(self, command: str, timeout: int = 30) -> Tuple[str, str, int]:
        try:
            result = subprocess.run(command, shell=True, capture_output=True, text=True, timeout=timeout)
            return result.stdout.strip(), result.stderr.strip(), result.returncode
        except subprocess.TimeoutExpired:
            return "", f"Command timeout after {timeout}s", -1

    def _get_timestamp(self) -> float:
        return get_boot_time_ms()

    def _get_file_stats(self, result: AtomicResult) -> dict:
        """从 diff 结果中提取文件变化统计"""
        diff = result.evidence.get('diff', {})
        stats = {
            'file_create_count': 0,
            'file_delete_count': 0,
            'file_modify_count': 0,
            'md5_change_count': 0
        }
        for file_path, change in diff.items():
            if change.get('status') == 'added':
                stats['file_create_count'] += 1
            elif change.get('status') == 'deleted':
                stats['file_delete_count'] += 1
            elif change.get('status') == 'modified':
                stats['file_modify_count'] += 1
            if change.get('md5_changed', False):
                stats['md5_change_count'] += 1
        return stats

    def _get_logcat_stats(self, start_ts: float, end_ts: float) -> dict:
        """获取时间窗口内的 logcat 统计"""
        import re
        cmd = f"adb -s {self.serial} logcat -v time -t {int((end_ts - start_ts)/1000) + 1}"
        try:
            result = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=5)
            lines = result.stdout.strip().split('\n')
            keywords = ['ActivityManager', 'MediaProvider', 'PackageManager', 'ContentResolver']
            keyword_count = 0
            for line in lines:
                for kw in keywords:
                    if kw in line:
                        keyword_count += 1
                        break
            return {
                'logcat_delta_lines': len(lines),
                'logcat_keyword_count': keyword_count
            }
        except:
            return {'logcat_delta_lines': 0, 'logcat_keyword_count': 0}

    def collect_evidence(self, result: AtomicResult) -> Dict[str, Any]:
        """默认实现，子类可以重写并添加更多字段"""
        file_stats = self._get_file_stats(result)
        log_stats = self._get_logcat_stats(result.timestamp_start, result.timestamp_end)
        return {
            'type': self.__class__.__name__.lower(),
            'timestamp': result.timestamp_start,
            'duration_ms': result.duration_ms,
            **file_stats,
            **log_stats
        }

    @abstractmethod
    def execute(self) -> AtomicResult:
        pass


# ============================================================
# 原子操作实现
# ============================================================

class UIClick(AtomicOperation):
    def execute(self) -> AtomicResult:
        x = self.params.get('x')
        y = self.params.get('y')
        if x is None or y is None:
            return AtomicResult(False, "", "x and y required", 0, 0, 0, error="x and y required")
        start_ts = self._get_timestamp()
        cmd = f"input tap {x} {y}"
        stdout, stderr, rc = self._execute_adb(cmd)
        end_ts = self._get_timestamp()
        return AtomicResult(
            success=(rc == 0), stdout=stdout, stderr=stderr,
            timestamp_start=start_ts, timestamp_end=end_ts,
            duration_ms=end_ts - start_ts,
            evidence={'x': x, 'y': y}
        )


class UISwipe(AtomicOperation):
    def execute(self) -> AtomicResult:
        x1 = self.params.get('x1')
        y1 = self.params.get('y1')
        x2 = self.params.get('x2')
        y2 = self.params.get('y2')
        duration = self.params.get('duration', 300)
        if None in (x1, y1, x2, y2):
            return AtomicResult(False, "", "x1,y1,x2,y2 required", 0, 0, 0, error="x1,y1,x2,y2 required")
        start_ts = self._get_timestamp()
        cmd = f"input swipe {x1} {y1} {x2} {y2} {duration}"
        stdout, stderr, rc = self._execute_adb(cmd)
        end_ts = self._get_timestamp()
        return AtomicResult(
            success=(rc == 0), stdout=stdout, stderr=stderr,
            timestamp_start=start_ts, timestamp_end=end_ts,
            duration_ms=end_ts - start_ts,
            evidence={'x1': x1, 'y1': y1, 'x2': x2, 'y2': y2, 'duration': duration}
        )


class UIInput(AtomicOperation):
    def execute(self) -> AtomicResult:
        text = self.params.get('text')
        if text is None:
            return AtomicResult(False, "", "text required", 0, 0, 0, error="text required")
        start_ts = self._get_timestamp()
        escaped_text = text.replace('"', '\\"').replace(' ', '%s')
        cmd = f"input text {escaped_text}"
        stdout, stderr, rc = self._execute_adb(cmd)
        end_ts = self._get_timestamp()
        return AtomicResult(
            success=(rc == 0), stdout=stdout, stderr=stderr,
            timestamp_start=start_ts, timestamp_end=end_ts,
            duration_ms=end_ts - start_ts,
            evidence={'text_length': len(text)}
        )


class FileCreate(AtomicOperation):
    def execute(self) -> AtomicResult:
        path = self.params.get('path')
        content = self.params.get('content', '')
        if not path:
            return AtomicResult(False, "", "path required", 0, 0, 0, error="path required")
        # 如果路径以 / 开头，直接使用；否则通过 _get_media_path 处理
        if path.startswith('/'):
            full_path = path
        else:
            full_path = self._get_media_path(path)
        start_ts = self._get_timestamp()
        # 创建目录
        dir_path = os.path.dirname(full_path)
        if dir_path and dir_path != '/':
            self._execute_adb(f"mkdir -p {dir_path}")
        escaped_content = content.replace('"', '\\"')
        cmd = f"echo \"{escaped_content}\" > {full_path}" if content else f"touch {full_path}"
        stdout, stderr, rc = self._execute_adb(cmd)
        end_ts = self._get_timestamp()
        return AtomicResult(
            success=(rc == 0), stdout=stdout, stderr=stderr,
            timestamp_start=start_ts, timestamp_end=end_ts,
            duration_ms=end_ts - start_ts,
            evidence={'path': full_path, 'content_length': len(content)}
        )

class FileCopy(AtomicOperation):
    def execute(self) -> AtomicResult:
        src = self.params.get('src')
        dst = self.params.get('dst')
        if not src or not dst:
            return AtomicResult(False, "", "src and dst required", 0, 0, 0, error="src and dst required")
        if src.startswith('/'):
            src_path = src
        else:
            src_path = self._get_media_path(src)
        if dst.startswith('/'):
            dst_path = dst
        else:
            dst_path = self._get_media_path(dst)
        start_ts = self._get_timestamp()
        # 确保目标目录存在
        dst_dir = os.path.dirname(dst_path)
        if dst_dir and dst_dir != '/':
            self._execute_adb(f"mkdir -p {dst_dir}")
        cmd = f"cp {src_path} {dst_path}"
        stdout, stderr, rc = self._execute_adb(cmd)
        end_ts = self._get_timestamp()
        return AtomicResult(
            success=(rc == 0), stdout=stdout, stderr=stderr,
            timestamp_start=start_ts, timestamp_end=end_ts,
            duration_ms=end_ts - start_ts,
            evidence={'src': src_path, 'dst': dst_path}
        )

class FileDelete(AtomicOperation):
    def execute(self) -> AtomicResult:
        path = self.params.get('path')
        if not path:
            return AtomicResult(False, "", "path required", 0, 0, 0, error="path required")
        if path.startswith('/'):
            full_path = path
        else:
            full_path = self._get_media_path(path)
        start_ts = self._get_timestamp()
        cmd = f"rm -f {full_path}"
        stdout, stderr, rc = self._execute_adb(cmd)
        end_ts = self._get_timestamp()
        return AtomicResult(
            success=(rc == 0), stdout=stdout, stderr=stderr,
            timestamp_start=start_ts, timestamp_end=end_ts,
            duration_ms=end_ts - start_ts,
            evidence={'path': full_path}
        )

class AppStart(AtomicOperation):
    def execute(self) -> AtomicResult:
        package = self.params.get('package')
        if not package:
            return AtomicResult(False, "", "package required", 0, 0, 0, error="package required")
        start_ts = self._get_timestamp()
        cmd = f"monkey -p {package} 1"
        stdout, stderr, rc = self._execute_adb(cmd)
        end_ts = self._get_timestamp()
        return AtomicResult(
            success=(rc == 0), stdout=stdout, stderr=stderr,
            timestamp_start=start_ts, timestamp_end=end_ts,
            duration_ms=end_ts - start_ts,
            evidence={'package': package}
        )


class AppStop(AtomicOperation):
    def execute(self) -> AtomicResult:
        package = self.params.get('package')
        if not package:
            return AtomicResult(False, "", "package required", 0, 0, 0, error="package required")
        start_ts = self._get_timestamp()
        cmd = f"am force-stop {package}"
        stdout, stderr, rc = self._execute_adb(cmd)
        end_ts = self._get_timestamp()
        return AtomicResult(
            success=(rc == 0), stdout=stdout, stderr=stderr,
            timestamp_start=start_ts, timestamp_end=end_ts,
            duration_ms=end_ts - start_ts,
            evidence={'package': package}
        )


class NetDownload(AtomicOperation):
    def execute(self) -> AtomicResult:
        import subprocess as sp
        url = self.params.get('url', '')
        dest = self.params.get('dest', '/data/local/tmp/')
        start_ts = self._get_timestamp()
        try:
            local_file = "/tmp/forensic_download.dat"
            sp.run(f"dd if=/dev/urandom of={local_file} bs=1M count=1", shell=True, check=True, capture_output=True)
            if not dest.endswith('/'):
                dest = dest + '/'
            remote_path = dest + 'downloaded.dat'
            serial = self.serial if hasattr(self, 'serial') else None
            if serial:
                adb_cmd = f"adb -s {serial} push {local_file} {remote_path}"
            else:
                adb_cmd = f"adb push {local_file} {remote_path}"
            stdout, stderr, rc = self._execute_adb_raw(adb_cmd, timeout=60)
            sp.run(f"rm {local_file}", shell=True)
        except subprocess.CalledProcessError as e:
            end_ts = self._get_timestamp()
            return AtomicResult(
                success=False, stdout="", stderr=str(e.stderr),
                timestamp_start=start_ts, timestamp_end=end_ts,
                duration_ms=end_ts - start_ts, error=str(e))
        except Exception as e:
            end_ts = self._get_timestamp()
            return AtomicResult(
                success=False, stdout="", stderr=str(e),
                timestamp_start=start_ts, timestamp_end=end_ts,
                duration_ms=end_ts - start_ts, error=str(e))
        end_ts = self._get_timestamp()
        return AtomicResult(
            success=(rc == 0), stdout=stdout, stderr=stderr,
            timestamp_start=start_ts, timestamp_end=end_ts,
            duration_ms=end_ts - start_ts,
            evidence={'url': url, 'dest': dest, 'remote_path': remote_path}
        )


# ============================================================
# 原子操作工厂
# ============================================================
class AtomicFactory:
    _registry = {
        'UI_CLICK': UIClick,
        'UI_SWIPE': UISwipe,
        'UI_INPUT': UIInput,
        'FILE_CREATE': FileCreate,
        'FILE_COPY': FileCopy,
        'FILE_DELETE': FileDelete,
        'APP_START': AppStart,
        'APP_STOP': AppStop,
        'NET_DOWNLOAD': NetDownload,
    }

    @classmethod
    def create(cls, op_type: str, api_level: int, serial: str = None, params: dict = None) -> AtomicOperation:
        op_class = cls._registry.get(op_type)
        if op_class is None:
            raise ValueError(f"Unknown operation type: {op_type}")
        if params is None:
            params = {}
        return op_class(api_level=api_level, serial=serial, params=params)

    @classmethod
    def register(cls, op_type: str, op_class):
        cls._registry[op_type] = op_class
