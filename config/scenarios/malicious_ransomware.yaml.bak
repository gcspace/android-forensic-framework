name: "勒索加密场景"
description: "模拟恶意应用遍历外部存储文档、图片并加密 (46原子)"
api_level: 33

nodes:
  # === 阶段1: 初始准备 (8原子) ===
  - id: click_1
    type: UI_CLICK
    params: {x: 100, y: 200}
    estimated_cost: 0.5
    depends_on: []
  
  - id: click_2
    type: UI_CLICK
    params: {x: 300, y: 400}
    estimated_cost: 0.5
    depends_on: [click_1]
  
  - id: swipe_1
    type: UI_SWIPE
    params: {x1: 100, y1: 500, x2: 300, y2: 500, duration: 300}
    estimated_cost: 0.8
    depends_on: [click_2]
  
  - id: click_3
    type: UI_CLICK
    params: {x: 200, y: 300}
    estimated_cost: 0.5
    depends_on: [swipe_1]
  
  - id: input_1
    type: UI_INPUT
    params: {text: "ransomware_exec"}
    estimated_cost: 0.3
    depends_on: [click_3]
  
  - id: click_4
    type: UI_CLICK
    params: {x: 400, y: 500}
    estimated_cost: 0.5
    depends_on: [input_1]
  
  - id: swipe_2
    type: UI_SWIPE
    params: {x1: 500, y1: 300, x2: 100, y2: 300, duration: 300}
    estimated_cost: 0.8
    depends_on: [click_4]
  
  - id: click_5
    type: UI_CLICK
    params: {x: 540, y: 400}
    estimated_cost: 0.5
    depends_on: [swipe_2]
  
  # === 阶段2: 遍历文档文件 (11原子，原12个删除doc_scan_12) ===
  - id: doc_scan_1
    type: FILE_CREATE
    params: {path: "Documents/doc_1.pdf", content: "PDF: Document 1 content", is_media: true}
    estimated_cost: 1.0
    depends_on: [click_5]
  
  - id: doc_scan_2
    type: FILE_CREATE
    params: {path: "Documents/doc_2.docx", content: "DOCX: Document 2 content", is_media: true}
    estimated_cost: 1.0
    depends_on: [click_5]
  
  - id: doc_scan_3
    type: FILE_CREATE
    params: {path: "Documents/doc_3.xlsx", content: "XLSX: Spreadsheet 3 content", is_media: true}
    estimated_cost: 1.0
    depends_on: [click_5]
  
  - id: doc_scan_4
    type: FILE_CREATE
    params: {path: "Documents/doc_4.ppt", content: "PPT: Presentation 4 content", is_media: true}
    estimated_cost: 1.0
    depends_on: [click_5]
  
  - id: doc_scan_5
    type: FILE_CREATE
    params: {path: "Documents/doc_5.txt", content: "TXT: Important notes 5", is_media: true}
    estimated_cost: 1.0
    depends_on: [click_5]
  
  - id: doc_scan_6
    type: FILE_CREATE
    params: {path: "Documents/doc_6.md", content: "MD: Readme 6", is_media: true}
    estimated_cost: 1.0
    depends_on: [click_5]
  
  - id: doc_scan_7
    type: FILE_CREATE
    params: {path: "Documents/doc_7.json", content: '{"data": "sensitive_data_7"}', is_media: true}
    estimated_cost: 1.0
    depends_on: [click_5]
  
  - id: doc_scan_8
    type: FILE_CREATE
    params: {path: "Documents/doc_8.xml", content: "<config><value>data_8</value></config>", is_media: true}
    estimated_cost: 1.0
    depends_on: [click_5]
  
  - id: doc_scan_9
    type: FILE_CREATE
    params: {path: "Documents/doc_9.csv", content: "col1,col2\nval1,val2", is_media: true}
    estimated_cost: 1.0
    depends_on: [doc_scan_8]
  
  - id: doc_scan_10
    type: FILE_CREATE
    params: {path: "Documents/doc_10.log", content: "LOG: System log entry 10", is_media: true}
    estimated_cost: 1.0
    depends_on: [click_5]
  
  - id: doc_scan_11
    type: FILE_CREATE
    params: {path: "Documents/doc_11.yaml", content: "key: value", is_media: true}
    estimated_cost: 1.0
    depends_on: [click_5]
  
  # === 阶段3: 遍历图片文件 (12原子) ===
  - id: img_scan_1
    type: FILE_CREATE
    params: {path: "Pictures/img_1.jpg", content: "JPG: Image 1", is_media: true}
    estimated_cost: 1.0
    depends_on: [click_5]
  
  - id: img_scan_2
    type: FILE_CREATE
    params: {path: "Pictures/img_2.png", content: "PNG: Image 2", is_media: true}
    estimated_cost: 1.0
    depends_on: [click_5]
  
  - id: img_scan_3
    type: FILE_CREATE
    params: {path: "Pictures/img_3.gif", content: "GIF: Image 3", is_media: true}
    estimated_cost: 1.0
    depends_on: [img_scan_2]
  
  - id: img_scan_4
    type: FILE_CREATE
    params: {path: "Pictures/img_4.bmp", content: "BMP: Image 4", is_media: true}
    estimated_cost: 1.0
    depends_on: [img_scan_3]
  
  - id: img_scan_5
    type: FILE_CREATE
    params: {path: "Pictures/img_5.webp", content: "WEBP: Image 5", is_media: true}
    estimated_cost: 1.0
    depends_on: [img_scan_4]
  
  - id: img_scan_6
    type: FILE_CREATE
    params: {path: "Pictures/img_6.svg", content: "SVG: Image 6", is_media: true}
    estimated_cost: 1.0
    depends_on: [img_scan_5]
  
  - id: img_scan_7
    type: FILE_CREATE
    params: {path: "Pictures/img_7.tiff", content: "TIFF: Image 7", is_media: true}
    estimated_cost: 1.0
    depends_on: [img_scan_6]
  
  - id: img_scan_8
    type: FILE_CREATE
    params: {path: "Pictures/img_8.heic", content: "HEIC: Image 8", is_media: true}
    estimated_cost: 1.0
    depends_on: [img_scan_7]
  
  - id: img_scan_9
    type: FILE_CREATE
    params: {path: "Pictures/img_9.jpg", content: "JPG: Image 9", is_media: true}
    estimated_cost: 1.0
    depends_on: [img_scan_8]
  
  - id: img_scan_10
    type: FILE_CREATE
    params: {path: "Pictures/img_10.png", content: "PNG: Image 10", is_media: true}
    estimated_cost: 1.0
    depends_on: [img_scan_9]
  
  - id: img_scan_11
    type: FILE_CREATE
    params: {path: "Pictures/img_11.jpg", content: "JPG: Image 11", is_media: true}
    estimated_cost: 1.0
    depends_on: [img_scan_10]
  
  - id: img_scan_12
    type: FILE_CREATE
    params: {path: "Pictures/img_12.jpg", content: "JPG: Image 12", is_media: true}
    estimated_cost: 1.0
    depends_on: [img_scan_11]
  
  # === 阶段4: 加密与源文件删除 (15原子) ===
  - id: create_encrypted_dir
    type: FILE_CREATE
    params: {path: ".encrypted/", content: "", is_media: false}
    estimated_cost: 0.3
    depends_on: [img_scan_12]
  
  - id: encrypt_doc_1
    type: FILE_COPY
    params: {src: "Documents/doc_1.pdf", dst: ".encrypted/doc_1.pdf.enc", is_media: true}
    estimated_cost: 0.8
    depends_on: [create_encrypted_dir]
  
  - id: encrypt_doc_2
    type: FILE_COPY
    params: {src: "Documents/doc_2.docx", dst: ".encrypted/doc_2.docx.enc", is_media: true}
    estimated_cost: 0.8
    depends_on: [encrypt_doc_1]
  
  - id: encrypt_doc_3
    type: FILE_COPY
    params: {src: "Documents/doc_3.xlsx", dst: ".encrypted/doc_3.xlsx.enc", is_media: true}
    estimated_cost: 0.8
    depends_on: [encrypt_doc_2]
  
  - id: delete_doc_1
    type: FILE_DELETE
    params: {path: "Documents/doc_1.pdf", is_media: true}
    estimated_cost: 0.5
    depends_on: [encrypt_doc_3]
  
  - id: delete_doc_2
    type: FILE_DELETE
    params: {path: "Documents/doc_2.docx", is_media: true}
    estimated_cost: 0.5
    depends_on: [delete_doc_1]
  
  - id: delete_doc_3
    type: FILE_DELETE
    params: {path: "Documents/doc_3.xlsx", is_media: true}
    estimated_cost: 0.5
    depends_on: [delete_doc_2]
  
  - id: encrypt_img_1
    type: FILE_COPY
    params: {src: "Pictures/img_1.jpg", dst: ".encrypted/img_1.jpg.enc", is_media: true}
    estimated_cost: 0.8
    depends_on: [delete_doc_3]
  
  - id: encrypt_img_2
    type: FILE_COPY
    params: {src: "Pictures/img_2.png", dst: ".encrypted/img_2.png.enc", is_media: true}
    estimated_cost: 0.8
    depends_on: [encrypt_img_1]
  
  - id: encrypt_img_3
    type: FILE_COPY
    params: {src: "Pictures/img_3.gif", dst: ".encrypted/img_3.gif.enc", is_media: true}
    estimated_cost: 0.8
    depends_on: [encrypt_img_2]
  
  - id: delete_img_1
    type: FILE_DELETE
    params: {path: "Pictures/img_1.jpg", is_media: true}
    estimated_cost: 0.5
    depends_on: [encrypt_img_3]
  
  - id: delete_img_2
    type: FILE_DELETE
    params: {path: "Pictures/img_2.png", is_media: true}
    estimated_cost: 0.5
    depends_on: [delete_img_1]
  
  - id: delete_img_3
    type: FILE_DELETE
    params: {path: "Pictures/img_3.gif", is_media: true}
    estimated_cost: 0.5
    depends_on: [delete_img_2]
  
  - id: ransom_note
    type: FILE_CREATE
    params: {path: "RANSOM_NOTE.txt", content: "YOUR FILES HAVE BEEN ENCRYPTED. Pay 0.5 BTC to recover.", is_media: false}
    estimated_cost: 0.5
    depends_on: [delete_img_3]
  
  - id: ransom_complete
    type: FILE_CREATE
    params: {path: "RANSOM_COMPLETE.flag", content: "ENCRYPTION_COMPLETE", is_media: false}
    estimated_cost: 0.3
    depends_on: [ransom_note]
